<Window x:Class="PearlRigCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PearlRigCore.Controls"
        Title="Pearl Rig Control v3.9.0" Height="980" Width="1380" MinHeight="760" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged" Closing="Window_Closing" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MetricCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="GpuMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GpuMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1118" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9C5D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBg" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBg" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#174B42" />
            <Setter Property="Foreground" Value="#E9FFFA" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="UpdatePulse">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" From="#174B42" To="#D48A20" Duration="0:0:0.75" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="UpdatePulse" /></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootChromeBorder" BorderBrush="#1F2B3A" BorderThickness="1" Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кастомная тёмная шапка окна (WindowChrome) -->
            <Border Grid.Row="0" Background="#070B10" BorderBrush="#182230" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="PEARL RIG CONTROL" FontSize="11.5" FontWeight="Bold" Foreground="#DCE6F2" VerticalAlignment="Center" />
                        <Border Background="#112E2B" BorderBrush="#1D5C53" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="v3.9.0" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding ComputerSummary}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeWindow_Click" ToolTip="Свернуть" />
                        <Button x:Name="MaximizeRestoreButton" Content="□" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreWindow_Click" ToolTip="Развернуть / Восстановить" />
                        <Button Content="✕" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseWindow_Click" ToolTip="Закрыть" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <Grid Grid.Row="1" Margin="20,12,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Верхняя панель управления -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#102D2A" BorderBrush="#20534B" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="P" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="УПРАВЛЕНИЕ МАЙНИНГОМ · NVML &amp; WATCHDOG" FontSize="14.5" FontWeight="Bold" />
                            <TextBlock Text="{Binding ActivePresetLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0">
                        <Button Content="ЗАПУСТИТЬ" Command="{Binding StartMinerCommand}" Padding="10,8" FontSize="10.5" Margin="0,0,4,0" ToolTip="Запустить OneZeroMiner с основным/резервным пулом PRL" />
                        <Button Content="ОСТАНОВИТЬ" Command="{Binding StopMinerCommand}" Padding="10,8" FontSize="10.5" Margin="0,0,4,0" Background="#6F3038" Foreground="#FFF1F2" ToolTip="Остановить майнер штатным Ctrl+C" />
                        <Button Content="РЕСТАРТ" Command="{Binding RestartMinerNowCommand}" Padding="9,8" FontSize="10.5" Margin="0,0,8,0" Background="#2B394E" Foreground="{StaticResource TextBrush}" ToolTip="Мягкий перезапуск майнера" />
                        <Button Content="{Binding MinerModeLabel}" Command="{Binding ToggleMinerModeCommand}" Padding="9,8" FontSize="10.5" Margin="0,0,4,0" Background="#273346" Foreground="{StaticResource TextBrush}" ToolTip="Автозапуск с Windows через Планировщик задач (/RL HIGHEST)" />
                        <Button Content="{Binding WatchdogButtonLabel}" Command="{Binding ToggleWatchdogCommand}" Padding="9,8" FontSize="10.5" Margin="0,0,4,0" Background="#1B3A36" Foreground="{StaticResource AccentBrush}" ToolTip="Включить или отключить аппаратный Watchdog и термозащиту" />
                        <Button Content="{Binding SmartFanButtonLabel}" Command="{Binding ToggleSmartFanCurveCommand}" Padding="9,8" FontSize="10.5" Margin="0,0,4,0" Background="#243044" Foreground="#93C5FD" ToolTip="Плавная кривая кулеров по максимуму Ядра и GDDR6X с гистерезисом" />
                        <Button Content="ОТЧЁТ CSV" Command="{Binding ExportCsvReportCommand}" Padding="9,8" FontSize="10.5" Background="#1F2E2B" Foreground="#A3E6D8" ToolTip="Сохранить текущий срез и открыть history.csv" />
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="9" Background="#111A23" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionHealthLevel}" Value="Connected"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionHealthLevel}" Value="Disconnected"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionHealthLevel}" Value="Warning"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#C9D4E0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Width="178" VerticalAlignment="Center">
                            <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}" Style="{StaticResource UpdateButtonStyle}" ToolTip="Проверить GitHub Releases и загрузить новую версию" />
                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" Background="#263243" Foreground="{StaticResource AccentBrush}" Margin="3,3,3,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="3,2,3,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpdateStatusText}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Подзаголовок состояния -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MinerControlStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding GpuCountLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Grid.Column="2" Content="ОБНОВИТЬ ДАННЫЕ" Command="{Binding RefreshCommand}" Padding="11,6" FontSize="10" />
                </Grid>

                <!-- Всплывающий Toast / InfoBar -->
                <Border Grid.Row="2" CornerRadius="9" BorderThickness="1" Padding="12,7" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Background" Value="#102235" />
                            <Setter Property="BorderBrush" Value="#2563EB" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasToast}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Success">
                                    <Setter Property="Background" Value="#0E2A26" />
                                    <Setter Property="BorderBrush" Value="#00E5C0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                                    <Setter Property="Background" Value="#2B2111" />
                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                                    <Setter Property="Background" Value="#2E1318" />
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ToastMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding DismissToastCommand}" Padding="6,2" FontSize="10.5" Background="Transparent" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </Border>

                <!-- Навигация по вкладкам -->
                <TabControl Grid.Row="3">
                    <!-- ВКЛАДКА 1: ОБЗОР И ДОХОД -->
                    <TabItem Header="ОБЗОР И ДОХОД">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="4" Margin="-6,0,-6,10">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ОБЩИЙ ХЕШРЕЙТ" Style="{StaticResource MetricCaption}" />
                                            <TextBlock Text="{Binding TotalHashrate}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding TotalEfficiency}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                        <controls:TelemetrySparkline Grid.Column="1" Height="46" VerticalAlignment="Center" Margin="8,0,0,0" Values="{Binding TotalHashrateHistory}" StrokeColor="#00E5C0" ShowScaleLabels="True" UnitSuffix="TH/s" ToolTip="Живой график общего хешрейта с Min/Max за сессию" />
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="ПРИНЯТО ШАР" Style="{StaticResource MetricCaption}" />
                                        <TextBlock Text="{Binding AcceptedShares}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="{Binding MinerUptimeText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="ОТКЛОНЕНО ШАР" Style="{StaticResource MetricCaption}" />
                                        <TextBlock Text="{Binding RejectedShares}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="{Binding WatchdogStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding WatchdogStatusText}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PoolConnectedState}" Value="Connected"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding PoolConnectedState}" Value="Disconnected"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="ПУЛ (ОСНОВНОЙ + РЕЗЕРВ)" Style="{StaticResource MetricCaption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PoolPingText}" Foreground="#93C5FD" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                        <TextBlock Text="{Binding PoolStatus}" Style="{StaticResource MetricValue}" FontSize="18" />
                                        <TextBlock Text="{Binding PoolUrl}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="15,11" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="БАЛАНС KRYPTEX" Style="{StaticResource MetricCaption}" />
                                        <TextBox Text="{Binding WalletAddressDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6" Padding="10,6" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" FontFamily="Consolas" FontSize="11" ToolTip="Публичный адрес PRL, хранится локально на этом компьютере" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Content="СОХРАНИТЬ АДРЕС" Command="{Binding SaveWalletCommand}" Padding="12,6" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding WalletStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="ФАКТИЧЕСКИЕ НАЧИСЛЕНИЯ И ЭКОНОМИКА · PRL" Style="{StaticResource MetricCaption}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PoolThresholdText}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="2" Text="{Binding PoolUpdated}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                        </Grid>
                                        <UniformGrid Columns="8">
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="ВСЕГО" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolBalance}" Style="{StaticResource GpuMetricValue}" FontSize="13" /></StackPanel>
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="ПОДТВЕРЖД." Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolConfirmed}" Style="{StaticResource GpuMetricValue}" FontSize="13" /></StackPanel>
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="ОЖИДАЕТСЯ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolUnconfirmed}" Style="{StaticResource GpuMetricValue}" FontSize="13" /></StackPanel>
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="ВЫПЛАЧЕНО" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolPaid}" Style="{StaticResource GpuMetricValue}" FontSize="13" /></StackPanel>
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="ЭКВИВАЛЕНТ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolRubEstimate}" Style="{StaticResource GpuMetricValue}" FontSize="13" Foreground="{StaticResource AccentBrush}" /></StackPanel>
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="РОЗЕТКА/СУТ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding DailyElectricityKpiText}" Style="{StaticResource GpuMetricValue}" FontSize="13" Foreground="#93C5FD" /></StackPanel>
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="ЧИСТЫМИ/СУТ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding DailyNetProfitKpiText}" Style="{StaticResource GpuMetricValue}" FontSize="13" Foreground="{StaticResource AccentBrush}" /></StackPanel>
                                            <StackPanel><TextBlock Text="ДО ВЫПЛАТЫ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PayoutEtaText}" Style="{StaticResource GpuMetricValue}" FontSize="13" /></StackPanel>
                                        </UniformGrid>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding PayoutProgressPercent, Mode=OneWay}" Background="#17232E" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding PayoutProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SessionAccumulationRate}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="{Binding ElectricitySummaryText}" Foreground="#93C5FD" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" ToolTip="{Binding NetProfitSummaryText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MarketRate}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Gpus}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceBrush}" BorderThickness="1" CornerRadius="16" Padding="18,13" Margin="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCoreTempWarning}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsVramTempWarning}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCoreTempCritical}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsVramTempCritical}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold" />
                                                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Border Background="#111C28" BorderBrush="#233346" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,5,0">
                                                                        <TextBlock Text="{Binding PcieBadgeText}" FontSize="9.5" Foreground="#93C5FD" FontFamily="Consolas" />
                                                                    </Border>
                                                                    <Border Background="#111C28" BorderBrush="#233346" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,5,0">
                                                                        <TextBlock Text="{Binding PStateBadgeText}" FontSize="9.5" Foreground="#A3E6D8" FontFamily="Consolas" />
                                                                    </Border>
                                                                    <Border Background="#111C28" BorderBrush="#233346" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,5,0">
                                                                        <TextBlock Text="{Binding LoadBadgeText}" FontSize="9.5" Foreground="#CBD5E1" Typography.NumeralAlignment="Tabular" />
                                                                    </Border>
                                                                    <Border Background="#111C28" BorderBrush="#233346" BorderThickness="1" CornerRadius="5" Padding="6,2">
                                                                        <TextBlock Text="{Binding EnergyCounterBadgeText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Typography.NumeralAlignment="Tabular" ToolTip="Аппаратный счётчик энергии чипа NVML" />
                                                                    </Border>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#102D2A" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="GPU #" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                        <Border Background="#0D141D" BorderBrush="#1C2937" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="136" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="ХЕШРЕЙТ И ЭНЕРГОЭФФЕКТИВНОСТЬ" Style="{StaticResource MetricCaption}" />
                                                                    <TextBlock Text="{Binding HashrateText}" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="Bold" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" />
                                                                    <TextBlock Text="{Binding EfficiencyText}" Foreground="#A3E6D8" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                                    <TextBlock Text="ДИНАМИКА TH/s / °C" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,3" />
                                                                    <controls:TelemetrySparkline Height="40" Values="{Binding HashrateHistory}" StrokeColor="#00E5C0" ShowScaleLabels="True" UnitSuffix="TH" Margin="0,0,0,4" />
                                                                    <controls:TelemetrySparkline Height="36" Values="{Binding TemperatureHistory}" StrokeColor="#F59E0B" ShowScaleLabels="True" UnitSuffix="°C" />
                                                                </StackPanel>
                                                                <controls:SpeedometerGauge Grid.Column="2" Width="130" Height="94" Value="{Binding HashrateTHs, TargetNullValue=0}" Maximum="{Binding DataContext.MaxGpuHashrateTHs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" HasData="{Binding HasHashrate}" Margin="6,0,0,0" />
                                                            </Grid>
                                                        </Border>
                                                        <UniformGrid Columns="4" Rows="2">
                                                            <StackPanel Margin="0,2,4,8">
                                                                <TextBlock Text="ТЕМП. ЯДРА" Style="{StaticResource GpuMetricLabel}" />
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TemperatureText}" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource GpuMetricValue}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCoreTempWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsCoreTempCritical}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Border Width="10" Height="28" Margin="7,3,0,0" Background="#0B1118" BorderBrush="#2A394A" BorderThickness="1" CornerRadius="5">
                                                                        <controls:TemperatureScale Margin="1.5" Value="{Binding TempC, TargetNullValue=0}" HasData="{Binding HasTemperature}" IsOverheated="{Binding IsOverheated}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,2,4,8">
                                                                <TextBlock Text="ПАМЯТЬ GDDR6X" Style="{StaticResource GpuMetricLabel}" />
                                                                <TextBlock Text="{Binding VramTemperatureText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GpuMetricValue}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsVramTempWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsVramTempCritical}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,2,4,8"><TextBlock Text="МОЩНОСТЬ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PowerText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                                            <StackPanel Margin="0,2,0,8"><TextBlock Text="ВЕНТИЛЯТОР" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding FanText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                                            <StackPanel Margin="0,2,4,0"><TextBlock Text="ЧАСТОТА ЯДРА" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding CoreClockText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                                            <StackPanel Margin="0,2,4,0"><TextBlock Text="ЧАСТОТА ПАМЯТИ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding MemoryClockText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                                            <StackPanel Margin="0,2,4,0">
                                                                <TextBlock Text="P-STATE / ДРАЙВЕР" Style="{StaticResource GpuMetricLabel}" />
                                                                <TextBlock Text="{Binding ThrottleText}" FontSize="12" ToolTip="{Binding SourceText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GpuMetricValue}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasThrottleWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,2,0,0"><TextBlock Text="ШАРЫ (ПРИН / ОТКЛ)" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding SharesText}" Style="{StaticResource GpuMetricValue}" FontSize="12" /></StackPanel>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Background="#111923" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding HasNoGpus}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Нет данных о видеокартах" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Подключите GPU или проверьте драйвер NVIDIA (nvml.dll / nvidia-smi) и локальный API майнера." Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ВКЛАДКА 2: РАЗГОН И КРИВАЯ КУЛЕРОВ -->
                    <TabItem Header="РАЗГОН И КУЛЕРЫ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ПРЕСЕТЫ РАЗГОНА И АВТО-БЕНЧМАРК ЭНЕРГОЭФФЕКТИВНОСТИ" Style="{StaticResource MetricCaption}" />
                                                <TextBlock Text="Выберите готовый профиль или запустите пошаговый подбор золотой точки GH/W." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding AutoTuneButtonLabel}" Command="{Binding RunAutoTuneBenchmarkCommand}" Padding="10,7" FontSize="10.5" Margin="0,0,8,0" Background="#3B2E14" Foreground="#FCD34D" />
                                                <Button Content="АВТО" Command="{Binding PresetAutoCommand}" Padding="10,7" FontSize="10.5" Margin="0,0,4,0" Background="#1D2837" Foreground="{StaticResource TextBrush}" />
                                                <Button Content="ECO" Command="{Binding PresetEcoCommand}" Padding="10,7" FontSize="10.5" Margin="0,0,4,0" Background="#133832" Foreground="{StaticResource AccentBrush}" />
                                                <Button Content="БАЛАНС" Command="{Binding PresetBalanceCommand}" Padding="10,7" FontSize="10.5" Margin="0,0,4,0" Background="#1B3248" Foreground="#93C5FD" />
                                                <Button Content="TURBO" Command="{Binding PresetTurboCommand}" Padding="10,7" FontSize="10.5" Margin="0,0,4,0" Background="#462B19" Foreground="#FCD34D" />
                                                <Button Content="ТИХИЙ" Command="{Binding PresetSilentCommand}" Padding="10,7" FontSize="10.5" Background="#2B243D" Foreground="#D8B4FE" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Прогресс авто-подбора GH/W -->
                                        <Border Background="#1D1A12" BorderBrush="#634B17" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsAutoTuning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AutoTuneProgressText}" Foreground="#FCD34D" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AutoTuneProgressPercent, StringFormat={}{0:0}%}" Foreground="#FCD34D" FontSize="11.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding AutoTuneProgressPercent, Mode=OneWay}" Background="#2E2614" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Таблица результатов авто-подбора GH/W -->
                                        <Border Background="#0B1118" BorderBrush="#233245" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasAutoTuneResults}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="РЕЗУЛЬТАТЫ СРАВНЕНИЯ ТОЧЕК GH/W" Style="{StaticResource MetricCaption}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding AutoTuneSteps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6" Padding="8,5" Margin="0,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#101824" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBest}" Value="True"><Setter Property="Background" Value="#10312C" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <UniformGrid Columns="6">
                                                                    <TextBlock Text="{Binding WattsText}" FontSize="11.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                                    <TextBlock Text="{Binding HashrateText}" FontSize="11.5" Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular" />
                                                                    <TextBlock Text="{Binding PowerText}" FontSize="11.5" Typography.NumeralAlignment="Tabular" />
                                                                    <TextBlock Text="{Binding EfficiencyText}" FontSize="11.5" FontWeight="Bold" Foreground="#A3E6D8" Typography.NumeralAlignment="Tabular" />
                                                                    <TextBlock Text="{Binding MaxTempText}" FontSize="11.5" Foreground="#FBBF24" Typography.NumeralAlignment="Tabular" />
                                                                    <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                                <Style.Triggers><DataTrigger Binding="{Binding IsBest}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </UniformGrid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#0C1B20" BorderBrush="#17645B" BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="ЛИМИТ МОЩНОСТИ GPU (NVML)" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PowerSliderValue, StringFormat={}{0:0} Вт}" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,10,0" Typography.NumeralAlignment="Tabular" />
                                                    <Button Grid.Column="2" Content="ПРИМЕНИТЬ ЛИМИТ" Command="{Binding ApplyPowerLimitNowCommand}" Padding="12,5" FontSize="10" Background="#14453D" Foreground="#E9FFFA" />
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PowerSliderMinimum, StringFormat={}{0:0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                    <Slider x:Name="PowerLimitSlider" Grid.Column="1" Minimum="{Binding PowerSliderMinimum}" Maximum="{Binding PowerSliderMaximum}" Value="{Binding PowerSliderValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdjustPowerLimit}" Height="34" Margin="8,0" TickFrequency="5" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="False" TickPlacement="BottomRight" AutoToolTipPlacement="TopLeft" ValueChanged="PowerLimitSlider_ValueChanged" primitives:Thumb.DragStarted="PowerLimitSlider_DragStarted" primitives:Thumb.DragCompleted="PowerLimitSlider_DragCompleted" PreviewMouseLeftButtonUp="PowerLimitSlider_MouseUp" KeyUp="PowerLimitSlider_KeyUp" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PowerSliderMaximum, StringFormat={}{0:0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <Border Grid.Row="2" Background="#17232E" CornerRadius="4" ClipToBounds="True" Margin="49,0">
                                                    <Border Height="8" HorizontalAlignment="Stretch" CornerRadius="4" RenderTransformOrigin="0,0.5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#00D6A2" Offset="0" />
                                                                <GradientStop Color="#D2D943" Offset="0.58" />
                                                                <GradientStop Color="#FF5B57" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.RenderTransform><ScaleTransform x:Name="PowerGaugeScale" ScaleX="0.2" /></Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                                <TextBlock Grid.Row="3" Text="{Binding PowerRangeHint}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <CheckBox Content="Индивидуальные настройки для каждой видеокарты (Per-GPU)" IsChecked="{Binding UseIndividualGpuOverclock}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="ВОРКЕР:" Style="{StaticResource GpuMetricLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Width="180" Text="{Binding WorkerNameDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Единый режим разгона -->
                                        <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <UniformGrid.Style>
                                                <Style TargetType="UniformGrid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding UseIndividualGpuOverclock}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </UniformGrid.Style>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="ЧАСТОТА ЯДРА (МГЦ, ЧЕРЕЗ ЗАПЯТУЮ ИЛИ АВТО)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding CoreClockDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="ЧАСТОТА ПАМЯТИ (МГЦ, ЧЕРЕЗ ЗАПЯТУЮ ИЛИ АВТО)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding MemoryClockDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,8"><TextBlock Text="ЛИМИТ МОЩНОСТИ (ВТ, ЧЕРЕЗ ЗАПЯТУЮ)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding PowerLimitDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="KERNEL ONEZEROMINER (0–16)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding KernelDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="ВЕНТИЛЯТОР CLI (% ИЛИ * / АВТО)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,0" VerticalAlignment="Bottom"><TextBlock Text="При переключении в Per-GPU значения автоматически синхронизируются с полями карт." Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" /></StackPanel>
                                        </UniformGrid>

                                        <!-- Индивидуальный режим разгона Per-GPU -->
                                        <ItemsControl ItemsSource="{Binding GpuOverclockRows}" Margin="0,0,0,10">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding UseIndividualGpuOverclock}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0D141D" BorderBrush="#233245" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="GPU #" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                                                                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding PowerRangeBadge}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Typography.NumeralAlignment="Tabular" />
                                                            </Grid>
                                                            <UniformGrid Columns="5">
                                                                <StackPanel Margin="0,0,8,0"><TextBlock Text="ЯДРО (МГЦ)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding CoreClock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,0"><TextBlock Text="ПАМЯТЬ (МГЦ)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding MemoryClock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,0"><TextBlock Text="ЛИМИТ (ВТ)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding PowerLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,0"><TextBlock Text="KERNEL (0–16)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding Kernel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0" /></StackPanel>
                                                                <StackPanel><TextBlock Text="КУЛЕР (% / *)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding Fan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0" /></StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <CheckBox Content="Автоматически перезапускать майнер при изменении частот, kernel, fan или пула" IsChecked="{Binding AutoRestartMinerOnOverclockChange}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="СОХРАНИТЬ И ПРИМЕНИТЬ ПРОФИЛЬ" Command="{Binding SaveMinerSettingsCommand}" Padding="16,9" FontSize="11.5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="НАСТРОЙКА ПЛАВНОЙ КРИВОЙ КУЛЕРОВ (SMART FAN CURVE)" Style="{StaticResource MetricCaption}" />
                                        <TextBlock Text="Линейная интерполяция по максимуму между температурой ядра и (GDDR6X − сдвиг) с гистерезисом." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,12" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="ТОЧКА 1: ТЕМП. (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanCurveTempLowCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="ТОЧКА 1: ОБОРОТЫ (%)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanCurveSpeedLowPctDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="ТОЧКА 2: ТЕМП. (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanCurveTempMidCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="ТОЧКА 2: ОБОРОТЫ (%)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanCurveSpeedMidPctDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="ТОЧКА 3: ТЕМП. (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanCurveTempHighCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="ТОЧКА 3: ОБОРОТЫ (%)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanCurveSpeedHighPctDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="ГИСТЕРЕЗИС (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanHysteresisCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                    <StackPanel Margin="0,0,0,0"><TextBlock Text="СДВИГ GDDR6X (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding VramTempOffsetCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                                </UniformGrid>
                                                <Border Background="#2E1318" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding FanCurveValidationError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding FanCurveValidationError}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" />
                                                </Border>
                                                <Button Content="СОХРАНИТЬ КРИВУЮ КУЛЕРОВ" Command="{Binding SaveFanCurveCommand}" HorizontalAlignment="Right" Padding="16,9" FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <controls:FanCurveGraph Height="168"
                                                                        TempLow="{Binding FanCurveTempLowValue}" SpeedLow="{Binding FanCurveSpeedLowValue}"
                                                                        TempMid="{Binding FanCurveTempMidValue}" SpeedMid="{Binding FanCurveSpeedMidValue}"
                                                                        TempHigh="{Binding FanCurveTempHighValue}" SpeedHigh="{Binding FanCurveSpeedHighValue}"
                                                                        Gpu0EffectiveTemp="{Binding Gpu0EffectiveTemp}" Gpu1EffectiveTemp="{Binding Gpu1EffectiveTemp}" />
                                                <TextBlock Text="Живая визуализация кривой (жёлтый маркер G0, синий G1 — эффективная темп.)" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="2,5,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ВКЛАДКА 3: WATCHDOG, ТАРИФЫ И ПУЛЫ -->
                    <TabItem Header="WATCHDOG, ТАРИФЫ И ПУЛЫ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ТЕРМОЗАЩИТА, WATCHDOG И АВТО-ПЕРЕКЛЮЧЕНИЕ ПУЛОВ" Style="{StaticResource MetricCaption}" />
                                                <TextBlock Text="{Binding PoolPingText}" Foreground="#93C5FD" FontSize="10.5" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#102D2A" BorderBrush="#1C4E47" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActivePoolBadgeText}" Foreground="{StaticResource AccentBrush}" FontSize="10.5" FontWeight="Bold" />
                                            </Border>
                                            <Button Grid.Column="2" Content="ПРОВЕРИТЬ ПИНГ" Command="{Binding PingPoolsNowCommand}" Padding="10,7" FontSize="10" Margin="0,0,6,0" Background="#1D2B3E" Foreground="#93C5FD" />
                                            <Button Grid.Column="3" Content="ПЕРЕКЛЮЧИТЬ ПУЛ (RU/EU)" Command="{Binding SwitchPoolManuallyCommand}" Padding="10,7" FontSize="10" Background="#163734" Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                        <UniformGrid Columns="3" Margin="0,4,0,10">
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="ПРЕДУПРЕЖДЕНИЕ ТЕМП. (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding WarningTempCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="АВАРИЙНЫЙ СТОП (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding CriticalStopTempCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,8"><TextBlock Text="ВОЗВРАТ ПОСЛЕ ОСТЫВАНИЯ (°C)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding ResumeTempCDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="РЕСТАРТ ПРИ 0 TH/s (СЕК.)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding ZeroHashrateRestartSecondsDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="СБОЕВ ПУЛА ДО ПЕРЕКЛЮЧЕНИЯ" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding PoolDropSwitchThresholdCountDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,0"><TextBlock Text="СТУПЕНЬ АВТО-ПОДБОРА GH/W (СЕК.)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding AutoTuneStepSecondsDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                        </UniformGrid>
                                        <CheckBox Content="Автоматически переключать работающий майнер на резервный пул при потере основного" IsChecked="{Binding AutoSwitchToBackupPoolOnDrop}" Margin="0,0,0,12" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="ОСНОВНОЙ ПУЛ (STRATUM)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding PrimaryPoolDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,0"><TextBlock Text="РЕЗЕРВНЫЙ ПУЛ (STRATUM)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding BackupPoolDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,5,0,0" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="ТАРИФЫ ЭЛЕКТРОЭНЕРГИИ И РАСПИСАНИЕ ДЕНЬ / НОЧЬ" Style="{StaticResource MetricCaption}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="{Binding DualTariffButtonLabel}" Command="{Binding ToggleDualTariffCommand}" Padding="10,6" FontSize="10" Margin="0,0,6,0" Background="#162A38" Foreground="#93C5FD" />
                                                <Button Content="{Binding NightScheduleButtonLabel}" Command="{Binding ToggleNightScheduleCommand}" Padding="10,6" FontSize="10" Background="#25213B" Foreground="#D8B4FE" />
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid Columns="3" Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Т1 ДЕНЬ (₽/КВТ·Ч)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding ElectricityRateDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="НАЧАЛО ДНЯ (ЧАС 0–23)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding DayTariffStartHourDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,8"><TextBlock Text="ДНЕВНОЙ ПРЕСЕТ" Style="{StaticResource GpuMetricLabel}" /><ComboBox ItemsSource="{Binding AvailableSchedulePresets}" SelectedItem="{Binding DaySchedulePreset}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Т2 НОЧЬ (₽/КВТ·Ч)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding NightElectricityRateDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="НАЧАЛО НОЧИ (ЧАС 0–23)" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding NightTariffStartHourDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,0,0,0"><TextBlock Text="НОЧНОЙ ПРЕСЕТ" Style="{StaticResource GpuMetricLabel}" /><ComboBox ItemsSource="{Binding AvailableSchedulePresets}" SelectedItem="{Binding NightSchedulePreset}" Margin="0,5,0,0" /></StackPanel>
                                        </UniformGrid>

                                        <Border Background="#0B1118" BorderBrush="#1C2937" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CurrentScheduleStatusText}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Border Background="#1D4E48" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" /><TextBlock Text="Т1 День" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,10,0" />
                                                        <Border Background="#312E81" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" /><TextBlock Text="Т2 Ночь" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                                <controls:TariffTimelineBar Height="38" DayStartHour="{Binding DayTariffStartHourValue}" NightStartHour="{Binding NightTariffStartHourValue}" DualTariffEnabled="{Binding DualTariffEnabled}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#2E1318" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding WatchdogValidationError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding WatchdogValidationError}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" />
                                        </Border>
                                        <Button Content="СОХРАНИТЬ ПАРАМЕТРЫ WATCHDOG, РАСПИСАНИЯ И ПУЛОВ" Command="{Binding SaveWatchdogAndScheduleCommand}" HorizontalAlignment="Right" Padding="16,9" FontSize="11.5" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ВКЛАДКА 4: ЖУРНАЛ, TELEGRAM И ДИАГНОСТИКА -->
                    <TabItem Header="ЖУРНАЛ, TELEGRAM И ДИАГНОСТИКА">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Панель самодиагностики системы -->
                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#0B1118" BorderBrush="#233245" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DiagAdminOk}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DiagAdminText}" FontSize="10.5" Foreground="#CBD5E1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B1118" BorderBrush="#233245" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DiagNvmlOk}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DiagNvmlText}" FontSize="10.5" Foreground="#CBD5E1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B1118" BorderBrush="#233245" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DiagMinerExeOk}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DiagMinerExeText}" FontSize="10.5" Foreground="#CBD5E1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B1118" BorderBrush="#233245" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DiagAutoStartOk}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DiagAutoStartText}" FontSize="10.5" Foreground="#CBD5E1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0B1118" BorderBrush="#233245" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,2,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DiagTdrOk}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DiagTdrText}" FontSize="10.5" Foreground="#CBD5E1" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="ПРОВЕРИТЬ СИСТЕМУ" Command="{Binding RunDiagnosticsNowCommand}" Padding="11,7" FontSize="10" Background="#1D2B3E" Foreground="#93C5FD" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Команда запуска -->
                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MinerCommandLinePreview, Mode=OneWay}" IsReadOnly="True" Background="#080D13" Foreground="#A3E6D8" BorderBrush="#1C2937" BorderThickness="1" Padding="10,7" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="СКОПИРОВАТЬ КОМАНДУ" Command="{Binding CopyCommandLineCommand}" Padding="12,8" FontSize="10.5" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="ПАПКА ЛОГОВ" Command="{Binding OpenLogsFolderCommand}" Padding="12,8" FontSize="10.5" Margin="8,0,0,0" Background="#243044" Foreground="#93C5FD" />
                                </Grid>
                            </Border>

                            <!-- Настройки Telegram с явными подписями полей и кнопкой показа токена -->
                            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="290" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Content="Telegram-алерты" IsChecked="{Binding TelegramEnabled}" VerticalAlignment="Bottom" Margin="0,0,12,7" />
                                        <CheckBox Grid.Column="1" Content="Команды бота" IsChecked="{Binding TelegramRemoteControlEnabled}" VerticalAlignment="Bottom" Margin="0,0,12,7" ToolTip="Приём команд (/status, /start_miner, /stop_miner, /reboot_miner, /eco, /balance, /turbo, /autotune) с вашего Chat ID" />
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="BOT TOKEN (DPAPI)" Style="{StaticResource GpuMetricLabel}" />
                                                <CheckBox x:Name="RevealTokenToggle" Grid.Column="1" Content="Показать" FontSize="10" Foreground="{StaticResource MutedBrush}" Checked="RevealTokenToggle_Changed" Unchecked="RevealTokenToggle_Changed" />
                                            </Grid>
                                            <Grid Margin="0,3,0,0">
                                                <PasswordBox x:Name="TelegramTokenBox" PasswordChanged="TelegramTokenBox_PasswordChanged" Padding="8,5" Background="#080D13" Foreground="{StaticResource TextBrush}" BorderBrush="#1C2937" BorderThickness="1" FontFamily="Consolas" FontSize="11" ToolTip="Bot Token от @BotFather (шифруется локально через Windows DPAPI)" />
                                                <TextBox x:Name="TelegramTokenPlainBox" Text="{Binding TelegramBotTokenDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Padding="8,5" FontSize="11" Visibility="Collapsed" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                            <TextBlock Text="CHAT ID" Style="{StaticResource GpuMetricLabel}" />
                                            <TextBox Text="{Binding TelegramChatIdDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Padding="8,5" Margin="0,3,0,0" ToolTip="Ваш Chat ID в Telegram" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="СОХРАНИТЬ" Command="{Binding SaveTelegramCommand}" Padding="12,7" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Bottom" />
                                        <Button Grid.Column="5" Content="ТЕСТ" Command="{Binding TestTelegramCommand}" Padding="12,7" FontSize="10.5" Background="#243044" Foreground="#93C5FD" Margin="0,0,10,0" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Column="6" Text="{Binding TelegramStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Bottom" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Text="Команды Telegram-бота (строго для вашего Chat ID): /status · /start_miner · /stop_miner · /reboot_miner · /eco · /balance · /turbo · /silent · /autotune" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                                </StackPanel>
                            </Border>

                            <!-- Панель поиска и фильтрации журналов -->
                            <Border Grid.Row="3" Background="#0F1722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LogSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Padding="8,5" FontSize="11" ToolTip="Фильтр строк по ключевому слову во всех трёх журналах" />
                                    <TextBlock Text="Поиск по логам…" Foreground="#4D5C70" FontSize="11" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding LogSearchQuery}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Grid.Column="1" Content="Только ошибки и предупреждения" IsChecked="{Binding LogOnlyWarningsAndErrors}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11.5" />
                                    <CheckBox Grid.Column="2" Content="Автопрокрутка" IsChecked="{Binding LogAutoScrollEnabled}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11.5" />
                                    <Button Grid.Column="4" Content="КОПИРОВАТЬ ЛОГИ" Command="{Binding CopyLogsCommand}" Padding="11,6" FontSize="10" Margin="0,0,6,0" Background="#1B3A36" Foreground="{StaticResource AccentBrush}" />
                                    <Button Grid.Column="5" Content="ОЧИСТИТЬ WATCHDOG" Command="{Binding ClearWatchdogLogCommand}" Padding="11,6" FontSize="10" Background="#2B394E" Foreground="{StaticResource TextBrush}" />
                                </Grid>
                            </Border>

                            <!-- Три колонки журналов -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="#0D141D" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="ONEZEROMINER.LOG" Style="{StaticResource MetricCaption}" Margin="0,0,0,6" />
                                        <ScrollViewer x:Name="MinerLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding FilteredMinerLogTail}" Foreground="#C9D4E0" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Background="#0D141D" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="СОБЫТИЯ WATCHDOG И ЗАЩИТЫ" Style="{StaticResource MetricCaption}" Margin="0,0,0,6" />
                                        <ScrollViewer x:Name="WatchdogLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding FilteredWatchdogEventsText}" Foreground="#93C5FD" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="#0D141D" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="ЖУРНАЛ ПРИЛОЖЕНИЯ (APP.LOG)" Style="{StaticResource MetricCaption}" Margin="0,0,0,6" />
                                        <ScrollViewer x:Name="AppLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding FilteredAppLogTail}" Foreground="#A3E6D8" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Нижняя строка состояния -->
                <Border Grid.Row="4" Background="#0E151E" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DetailStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding NetProfitSummaryText}" Foreground="{StaticResource AccentBrush}" FontSize="10.5" Margin="14,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Grid.Column="2" Text="{Binding LastUpdated}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
