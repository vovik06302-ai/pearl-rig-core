<Window x:Class="PearlRigCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PearlRigCore.Controls"
        Title="Pearl Rig Control v3.7.2" Height="980" Width="1340" MinHeight="760" MinWidth="1060"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="MetricCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GpuMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GpuMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#174B42" />
            <Setter Property="Foreground" Value="#E9FFFA" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="UpdatePulse">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" From="#174B42" To="#D48A20" Duration="0:0:0.75" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="UpdatePulse" /></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="13" Background="#102D2A" BorderBrush="#20534B" BorderThickness="1" Margin="0,0,14,0">
                    <TextBlock Text="P" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PEARL RIG CONTROL · NVML &amp; WATCHDOG" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="NVML P-STATE · АВТО-БЕНЧМАРК GH/W · ДЕНЬ/НОЧЬ · TELEGRAM-УПРАВЛЕНИЕ · ПИНГ ПУЛОВ · CSV" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="ЗАПУСТИТЬ" Command="{Binding StartMinerCommand}" Padding="10,9" FontSize="10.5" Margin="0,0,4,0" ToolTip="Запустить OneZeroMiner с основным и резервным пулом PRL" />
                <Button Content="ОСТАНОВИТЬ" Command="{Binding StopMinerCommand}" Padding="10,9" FontSize="10.5" Margin="0,0,4,0" Background="#6F3038" Foreground="#FFF1F2" ToolTip="Остановить майнер штатным Ctrl+C" />
                <Button Content="{Binding MinerModeLabel}" Command="{Binding ToggleMinerModeCommand}" Padding="9,9" FontSize="10.5" Margin="0,0,4,0" Background="#273346" Foreground="{StaticResource TextBrush}" ToolTip="Автозапуск с Windows через Планировщик задач (/RL HIGHEST) и автовозврат после перезагрузки" />
                <Button Content="{Binding WatchdogButtonLabel}" Command="{Binding ToggleWatchdogCommand}" Padding="9,9" FontSize="10.5" Margin="0,0,4,0" Background="#1B3A36" Foreground="{StaticResource AccentBrush}" ToolTip="Включить или отключить аппаратный Watchdog и термозащиту" />
                <Button Content="{Binding SmartFanButtonLabel}" Command="{Binding ToggleSmartFanCurveCommand}" Padding="9,9" FontSize="10.5" Margin="0,0,4,0" Background="#243044" Foreground="#93C5FD" ToolTip="Плавное управление кулерами по максимуму из температур Ядра и GDDR6X с гистерезисом" />
                <Button Content="ОТЧЁТ CSV" Command="{Binding ExportCsvReportCommand}" Padding="9,9" FontSize="10.5" Margin="0,0,7,0" Background="#1F2E2B" Foreground="#A3E6D8" ToolTip="Сохранить текущий срез и открыть журнал доходности и телеметрии history.csv для Excel" />
                <Border CornerRadius="9" Background="#111A23" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="10,9" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#C9D4E0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Width="190" VerticalAlignment="Center">
                    <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}" Style="{StaticResource UpdateButtonStyle}" ToolTip="Проверить GitHub Releases и загрузить новую версию" />
                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" Background="#263243" Foreground="{StaticResource AccentBrush}" Margin="3,3,3,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="3,3,3,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpdateStatusText}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Показатели фермы" FontSize="22" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="{Binding MinerControlStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,12,0" />
            <Button Grid.Column="2" Content="ОБНОВИТЬ ДАННЫЕ" Command="{Binding RefreshCommand}" Padding="11,7" FontSize="10" ToolTip="Запросить свежие показания GPU (NVML/SMI), майнера, пинга пулов и баланса" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ComputerSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GpuCountLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,4,0,0" />
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4" Margin="-6,0,-6,12">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ОБЩИЙ ХЕШРЕЙТ" Style="{StaticResource MetricCaption}" />
                        <TextBlock Text="{Binding TotalHashrate}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding TotalEfficiency}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <controls:TelemetrySparkline Grid.Column="1" Height="42" VerticalAlignment="Center" Margin="8,0,0,0" Values="{Binding TotalHashrateHistory}" StrokeColor="#00E5C0" ToolTip="Живой график общего хешрейта за последние опросы" />
                </Grid>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                <StackPanel>
                    <TextBlock Text="ПРИНЯТО ШАР" Style="{StaticResource MetricCaption}" />
                    <TextBlock Text="{Binding AcceptedShares}" Style="{StaticResource MetricValue}" />
                    <TextBlock Text="{Binding MinerUptimeText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                <StackPanel>
                    <TextBlock Text="ОТКЛОНЕНО ШАР" Style="{StaticResource MetricCaption}" />
                    <TextBlock Text="{Binding RejectedShares}" Style="{StaticResource MetricValue}" />
                    <TextBlock Text="{Binding WatchdogStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding WatchdogStatusText}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="ПУЛ (ОСНОВНОЙ + РЕЗЕРВ)" Style="{StaticResource MetricCaption}" />
                        <TextBlock Grid.Column="1" Text="{Binding PoolPingText}" Foreground="#93C5FD" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding PoolStatus}" Style="{StaticResource MetricValue}" FontSize="18" />
                    <TextBlock Text="{Binding PoolUrl}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="15,11" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="БАЛАНС KRYPTEX" Style="{StaticResource MetricCaption}" />
                    <TextBox Text="{Binding WalletAddressDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,6" Padding="10,6" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" FontFamily="Consolas" FontSize="11" ToolTip="Публичный адрес PRL, хранится локально на этом компьютере" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="СОХРАНИТЬ АДРЕС" Command="{Binding SaveWalletCommand}" Padding="12,6" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding WalletStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="ФАКТИЧЕСКИЕ НАЧИСЛЕНИЯ · PRL" Style="{StaticResource MetricCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PoolThresholdText}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="2" Text="{Binding PoolUpdated}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                    </Grid>
                    <UniformGrid Columns="5">
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="ВСЕГО" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolBalance}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="ПОДТВЕРЖДЕНО" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolConfirmed}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="ОЖИДАЕТСЯ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolUnconfirmed}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="ВЫПЛАЧЕНО" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolPaid}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                        <StackPanel><TextBlock Text="ЭКВИВАЛЕНТ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PoolRubEstimate}" Style="{StaticResource GpuMetricValue}" Foreground="{StaticResource AccentBrush}" /></StackPanel>
                    </UniformGrid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding PayoutProgressPercent, Mode=OneWay}" Background="#17232E" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding PayoutProgressText}" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SessionAccumulationRate}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ElectricitySummaryText}" Foreground="#93C5FD" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding NetProfitSummaryText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding MarketRate}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ПРЕСЕТЫ, ТАРИФ ДЕНЬ/НОЧЬ И АВТО-БЕНЧМАРК" Style="{StaticResource MetricCaption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ActivePresetLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{Binding DualTariffButtonLabel}" Command="{Binding ToggleDualTariffCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,4,0" Background="#162A38" Foreground="#93C5FD" ToolTip="Переключить единый тариф и двухтарифный учёт День (07:00–23:00) / Ночь (23:00–07:00)" />
                        <Button Content="{Binding NightScheduleButtonLabel}" Command="{Binding ToggleNightScheduleCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,4,0" Background="#25213B" Foreground="#D8B4FE" ToolTip="Автоматически включать Eco днём (07:00) и Balance ночью (23:00)" />
                        <Button Content="{Binding AutoTuneButtonLabel}" Command="{Binding RunAutoTuneBenchmarkCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,8,0" Background="#3B2E14" Foreground="#FCD34D" ToolTip="Пошагово протестировать Power Limit при запущенном майнере и выбрать золотую точку с максимальным GH/W" />
                        <Button Content="АВТО" Command="{Binding PresetAutoCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,4,0" Background="#1D2837" Foreground="{StaticResource TextBrush}" ToolTip="Сбросить лимит мощности к заводскому значению VBIOS" />
                        <Button Content="ECO" Command="{Binding PresetEcoCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,4,0" Background="#133832" Foreground="{StaticResource AccentBrush}" ToolTip="Применить энергоэффективный профиль 135 Вт" />
                        <Button Content="БАЛАНС" Command="{Binding PresetBalanceCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,4,0" Background="#1B3248" Foreground="#93C5FD" ToolTip="Применить оптимальный профиль 150 Вт" />
                        <Button Content="TURBO" Command="{Binding PresetTurboCommand}" Padding="8,5" FontSize="9.5" Margin="0,0,4,0" Background="#462B19" Foreground="#FCD34D" ToolTip="Применить производительный профиль 185 Вт" />
                        <Button Content="ТИХИЙ" Command="{Binding PresetSilentCommand}" Padding="8,5" FontSize="9.5" Background="#2B243D" Foreground="#D8B4FE" ToolTip="Применить тихий профиль 125 Вт" />
                    </StackPanel>
                </Grid>
                <Border Background="#0C1B20" BorderBrush="#17645B" BorderThickness="1" CornerRadius="11" Padding="13,8" Margin="0,0,0,9">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ЛИМИТ МОЩНОСТИ GPU · ПЕРЕДВИНЬТЕ ПОЛЗУНОК ПО ГОРИЗОНТАЛЬНОЙ ШКАЛЕ" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PowerSliderValue, StringFormat={}{0:0} Вт}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,10,0" />
                            <Button Grid.Column="2" Content="ПРИМЕНИТЬ ЛИМИТ" Command="{Binding ApplyPowerLimitNowCommand}" Padding="10,4" FontSize="9.5" Background="#14453D" Foreground="#E9FFFA" VerticalAlignment="Center" ToolTip="Немедленно записать выбранный лимит мощности (Вт) во все видеокарты через NVML" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PowerSliderMinimum, StringFormat={}{0:0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Slider x:Name="PowerLimitSlider" Grid.Column="1" Minimum="{Binding PowerSliderMinimum}" Maximum="{Binding PowerSliderMaximum}" Value="{Binding PowerSliderValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdjustPowerLimit}" Height="34" Margin="8,0" TickFrequency="5" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="False" TickPlacement="BottomRight" AutoToolTipPlacement="TopLeft" ValueChanged="PowerLimitSlider_ValueChanged" primitives:Thumb.DragStarted="PowerLimitSlider_DragStarted" primitives:Thumb.DragCompleted="PowerLimitSlider_DragCompleted" PreviewMouseLeftButtonUp="PowerLimitSlider_MouseUp" KeyUp="PowerLimitSlider_KeyUp" />
                            <TextBlock Grid.Column="2" Text="{Binding PowerSliderMaximum, StringFormat={}{0:0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="2" Background="#17232E" CornerRadius="4" ClipToBounds="True" Margin="49,0">
                            <Border Height="8" HorizontalAlignment="Stretch" CornerRadius="4" RenderTransformOrigin="0,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00D6A2" Offset="0" />
                                        <GradientStop Color="#D2D943" Offset="0.58" />
                                        <GradientStop Color="#FF5B57" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform><ScaleTransform x:Name="PowerGaugeScale" ScaleX="0.2" /></Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock Grid.Row="3" Text="{Binding PowerRangeHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <UniformGrid Columns="9">
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="ИМЯ РАБОТНИКА" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding WorkerNameDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="ЯДРО · ID GPU" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding CoreClockDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="ПАМЯТЬ · ID GPU" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding MemoryClockDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="ЛИМИТЫ · ID GPU" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding PowerLimitDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="KERNEL · ID GPU" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding KernelDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="ВЕНТИЛЯТОР" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding FanDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Т1 ДЕНЬ ₽/кВт·ч" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding ElectricityRateDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" ToolTip="Дневной или единый тариф электроэнергии в рублях за 1 кВт·ч" /></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Т2 НОЧЬ ₽/кВт·ч" Style="{StaticResource GpuMetricLabel}" /><TextBox Text="{Binding NightElectricityRateDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,5" Background="#0B1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" ToolTip="Ночной тариф электроэнергии (23:00–07:00) в рублях за 1 кВт·ч" /></StackPanel>
                    <Button Content="СОХРАНИТЬ И ПРИМЕНИТЬ" Command="{Binding SaveMinerSettingsCommand}" Padding="6,7" FontSize="10" VerticalAlignment="Bottom" ToolTip="Сохранить профиль и применить лимит мощности через NVML / драйвер NVIDIA" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Gpus}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#102D2A" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="GPU #" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Background="#0D141D" BorderBrush="#1C2937" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ХЕШРЕЙТ И ЭНЕРГОЭФФЕКТИВНОСТЬ" Style="{StaticResource MetricCaption}" />
                                                <TextBlock Text="{Binding HashrateText}" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="Bold" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding EfficiencyText}" Foreground="#A3E6D8" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="ДИНАМИКА TH/s / °C" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,3" />
                                                <controls:TelemetrySparkline Height="32" Values="{Binding HashrateHistory}" StrokeColor="#00E5C0" Margin="0,0,0,4" />
                                                <controls:TelemetrySparkline Height="26" Values="{Binding TemperatureHistory}" StrokeColor="#F59E0B" />
                                            </StackPanel>
                                            <controls:SpeedometerGauge Grid.Column="2" Width="130" Height="94" Value="{Binding HashrateTHs, TargetNullValue=0}" Maximum="{Binding DataContext.MaxGpuHashrateTHs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" HasData="{Binding HasHashrate}" Margin="6,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <UniformGrid Columns="4" Rows="2">
                                        <StackPanel Margin="0,2,4,8">
                                            <TextBlock Text="ТЕМП. ЯДРА" Style="{StaticResource GpuMetricLabel}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource GpuMetricValue}" VerticalAlignment="Center" />
                                                <Border Width="10" Height="28" Margin="7,3,0,0" Background="#0B1118" BorderBrush="#2A394A" BorderThickness="1" CornerRadius="5">
                                                    <controls:TemperatureScale Margin="1.5" Value="{Binding TempC, TargetNullValue=0}" HasData="{Binding HasTemperature}" IsOverheated="{Binding IsOverheated}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,2,4,8"><TextBlock Text="ПАМЯТЬ GDDR6X" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding VramTemperatureText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                        <StackPanel Margin="0,2,4,8"><TextBlock Text="МОЩНОСТЬ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding PowerText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                        <StackPanel Margin="0,2,0,8"><TextBlock Text="ВЕНТИЛЯТОР" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding FanText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                        <StackPanel Margin="0,2,4,0"><TextBlock Text="ЧАСТОТА ЯДРА" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding CoreClockText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                        <StackPanel Margin="0,2,4,0"><TextBlock Text="ЧАСТОТА ПАМЯТИ" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding MemoryClockText}" Style="{StaticResource GpuMetricValue}" /></StackPanel>
                                        <StackPanel Margin="0,2,4,0"><TextBlock Text="P-STATE / ДРАЙВЕР" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding ThrottleText}" Style="{StaticResource GpuMetricValue}" FontSize="12" ToolTip="{Binding ThrottleText}" /></StackPanel>
                                        <StackPanel Margin="0,2,0,0"><TextBlock Text="ШАРЫ (ПРИН / ОТКЛ)" Style="{StaticResource GpuMetricLabel}" /><TextBlock Text="{Binding SharesText}" Style="{StaticResource GpuMetricValue}" FontSize="12" /></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="#111923" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasNoGpus}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Нет данных о видеокартах" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Подключите GPU или проверьте драйвер NVIDIA (nvml.dll / nvidia-smi) и локальный API майнера." Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Expander Grid.Row="6" Header="ЖУРНАЛ ONEZEROMINER · СОБЫТИЯ WATCHDOG · TELEGRAM-УПРАВЛЕНИЕ (/status, /preset, /start_miner) · КОМАНДНАЯ СТРОКА" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,8,6,0" IsExpanded="False">
            <Border Background="#0D141D" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="105" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding MinerCommandLinePreview, Mode=OneWay}" IsReadOnly="True" Background="#080D13" Foreground="#A3E6D8" BorderBrush="#1C2937" BorderThickness="1" Padding="8,5" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="СКОПИРОВАТЬ КОМАНДУ" Command="{Binding CopyCommandLineCommand}" Padding="10,6" FontSize="10" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Telegram-алерты" IsChecked="{Binding TelegramEnabled}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <CheckBox Grid.Column="1" Content="Команды бота" IsChecked="{Binding TelegramRemoteControlEnabled}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Разрешить приём команд (/status, /start_miner, /stop_miner, /reboot_miner, /eco, /balance, /turbo, /autotune) строго с вашего Chat ID" />
                        <TextBox Grid.Column="2" Text="{Binding TelegramBotTokenDraft, UpdateSourceTrigger=PropertyChanged}" Padding="7,4" Margin="0,0,8,0" Background="#080D13" Foreground="{StaticResource TextBrush}" BorderBrush="#1C2937" BorderThickness="1" FontFamily="Consolas" FontSize="10.5" ToolTip="Bot Token от @BotFather (хранится только локально)" />
                        <TextBox Grid.Column="3" Text="{Binding TelegramChatIdDraft, UpdateSourceTrigger=PropertyChanged}" Padding="7,4" Margin="0,0,8,0" Background="#080D13" Foreground="{StaticResource TextBrush}" BorderBrush="#1C2937" BorderThickness="1" FontFamily="Consolas" FontSize="10.5" ToolTip="Ваш Chat ID в Telegram" />
                        <Button Grid.Column="4" Content="СОХРАНИТЬ" Command="{Binding SaveTelegramCommand}" Padding="10,5" FontSize="10" Margin="0,0,6,0" />
                        <Button Grid.Column="5" Content="ТЕСТ" Command="{Binding TestTelegramCommand}" Padding="10,5" FontSize="10" Background="#243044" Foreground="#93C5FD" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="6" Text="{Binding TelegramStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#080D13" BorderBrush="#1C2937" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,5,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding MinerLogTail}" Foreground="#C9D4E0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="#080D13" BorderBrush="#1C2937" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="5,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding WatchdogEventsText}" Foreground="#93C5FD" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Expander>

        <Border Grid.Row="7" Background="#0E151E" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="6,8,6,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DetailStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding NetProfitSummaryText}" Foreground="{StaticResource AccentBrush}" FontSize="10.5" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding LastUpdated}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
